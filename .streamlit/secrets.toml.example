# .streamlit/secrets.toml.example -- TEMPLATE. Copy to secrets.toml, fill in.
#
# Copy this file from .streamlit/secrets.toml.example, or restore the real
# values here, and NEVER commit it (see .gitignore).
#
# Do NOT edit this file with real credentials — it is not gitignored, so
# anything you type here gets committed.

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USERNAME = "your.address@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"
SMTP_FROM_EMAIL = "your.address@gmail.com"
